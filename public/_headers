# Header cache untuk Cloudflare Pages.
# File "penentu versi" harus SELALU diambil ulang dari server, supaya
# browser/PWA langsung tahu ada update tanpa user perlu hapus cache.
/index.html
  Cache-Control: no-cache, must-revalidate
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate
/version.json
  Cache-Control: no-cache, no-store, must-revalidate
/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate

# Aset hasil build punya hash di nama file-nya, jadi aman di-cache lama
# di browser. Tapi cache server Cloudflare (edge) dibatasi 10 menit: kalau
# sebuah berkas diminta sebelum deploy selesai, Cloudflare menjawab dengan
# index.html (aturan SPA di _redirects) — dan jawaban salah itu dulu ikut
# tersimpan setahun, membuat Loan Monitoring tidak bisa dibuka (Nov 2026).
# Dengan batas ini jawaban salah hilang sendiri dalam 10 menit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Cloudflare-CDN-Cache-Control: max-age=600
