# Salin file ini jadi ".env" untuk development lokal, atau isi sebagai
# environment variable di dashboard Cloudflare Pages (Settings > Environment variables)
# untuk build production. Nilai di bawah ini WAJIB pakai project Supabase milik sendiri
# (bukan lagi project yang dikelola Lovable Cloud).

VITE_SUPABASE_URL="https://<project-ref-baru>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-public-key-project-baru>"
VITE_SUPABASE_PROJECT_ID="<project-ref-baru>"
